    "test": "ava",
    "coverage": "c8 ava"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawidrylko/mergerocket.git"
  },
  "bugs": {
    "url": "https://github.com/dawidrylko/mergerocket/issues"
  },
